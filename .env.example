# Config do roboto (D4/D17) — como a config chega ao sistema.
# DEV: copie para .env (gitignored) e preencha. PROD: estes valores são renderizados
# a partir do ansible-vault (a única var no GitHub é ANSIBLE_VAULT_PASSWORD, D4).
# 1 instância por empresa (D17) => um tenant por processo.
# Preencher de verdade é o PASSO FINAL antes do teste ao vivo.
#
# ALTERNATIVA (trilha O): sem .env, suba só com DATABASE_URL + CONSOLE_TOKEN — o daemon entra em
# "modo setup" e você preenche o resto pelo cockpit (http://host:8088). Tudo abaixo (menos esses
# dois, que são bootstrap) persiste no banco; o .env, quando existe, só SEMEIA o banco no boot.

# --- identidade / dados ---
ROBOTO_TENANT=acme
DATABASE_URL=postgresql://roboto:dev-only-change-me@localhost:5432/roboto
ROBOTO_DEFAULT_REPO=acme/app        # repo-alvo das issues do refino (owner/name)
LEASE_SECONDS=300                   # opcional (default 300)

# --- GitHub App (controle fino, N repos por org — D17/D21) ---
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=7891011
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=troque-isto                 # valida HMAC dos webhooks inbound

# --- Telegram (bot por empresa; tenant vem do servidor, não da mensagem — D21) ---
TELEGRAM_BOT_TOKEN=000000:AAA...
TELEGRAM_ALLOWLIST=111111111,222222222   # user IDs autorizados (vazio = ninguém)

# --- Modelos (OpenRouter) + STT (OpenAI-compatível) ---
OPENROUTER_API_KEY=sk-or-...
STT_API_KEY=sk-...
STT_BASE_URL=https://api.openai.com/v1    # opcional

# --- Console web (D25) ---
CONSOLE_TOKEN=troque-isto                 # bearer do console; vazio = console desabilitado
