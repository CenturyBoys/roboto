# Config do PoC (N3). Copie para poc/.env.poc (gitignored) e preencha.
# PROD renderiza do ansible-vault; aqui é só o PoC isolado.

# --- repos (1 empresa = N repos, D17) ---
TARGET_REPO_URL=https://github.com/arenavalendo/main.git  # repo que o PoC clona no container
GITHUB_CLONE_TOKEN=                  # PAT (mesmo do GITHUB_API_TOKEN) p/ clonar https; vazio=ssh
ROBOTO_DEFAULT_REPO=arenavalendo/main                     # onde nascem issues vindas do Telegram
ROBOTO_REPOS=arenavalendo/main                            # vírgulas p/ vários: a/x,a/y,a/z (vazio=só o default)
ROBOTO_TENANT=arenavalendo

# --- motor (Fase 0: stub | Fase 1: claude_code) ---
ROBOTO_ENGINE=claude_code
ROBOTO_CHAT_ID=                     # chat do Telegram p/ perguntas do motor
# Smoke observável da Fase 1: se setar POC_TASK, o container roda SÓ o motor nessa tarefa e
# imprime cada evento (sem Postgres/Telegram/daemon). Deixe vazio p/ rodar o daemon completo.
POC_TASK=

# --- modelos via OpenRouter (Claude Code vai via ccr; gateway nativo idem) ---
OPENROUTER_API_KEY=sk-or-...
STT_API_KEY=sk-...
STT_BASE_URL=https://api.openai.com/v1

# --- Telegram (bot da empresa) ---
TELEGRAM_BOT_TOKEN=000000:AAA...
TELEGRAM_ALLOWLIST=
CONSOLE_TOKEN=troque-isto

# --- GitHub: escolha UM modo ---
# modo PAT (recomendado p/ PoC): 1 token fine-grained (Contents RW + Issues RW + Pull requests RW).
# Serve p/ API (PR/issue) E p/ clonar (use o mesmo em GITHUB_CLONE_TOKEN acima).
GITHUB_API_TOKEN=github_pat_...
# modo App (produção; deixe vazio no PoC PAT):
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=              # só p/ receber webhook inbound

# --- infra ---
DB_PASSWORD=dev-only-change-me
