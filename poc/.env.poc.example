# Config do PoC (N3). Copie para poc/.env.poc (gitignored) e preencha.
# PROD renderiza do ansible-vault; aqui é só o PoC isolado.

# --- repo-alvo ---
TARGET_REPO_URL=https://github.com/arenavalendo/main.git
GITHUB_CLONE_TOKEN=                  # PAT fine-grained (repo contents RO) p/ clonar no PoC; vazio=ssh
ROBOTO_DEFAULT_REPO=arenavalendo/main
ROBOTO_TENANT=arenavalendo

# --- motor (Fase 0: stub | Fase 1: claude_code) ---
ROBOTO_ENGINE=stub
ROBOTO_CHAT_ID=                     # chat do Telegram p/ perguntas do motor

# --- modelos via OpenRouter (Claude Code vai via ccr; gateway nativo idem) ---
OPENROUTER_API_KEY=sk-or-...
STT_API_KEY=sk-...
STT_BASE_URL=https://api.openai.com/v1

# --- Telegram (bot da empresa) ---
TELEGRAM_BOT_TOKEN=000000:AAA...
TELEGRAM_ALLOWLIST=
CONSOLE_TOKEN=troque-isto

# --- GitHub App (instalado no repo-alvo) ---
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=7891011
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=troque-isto

# --- infra ---
DB_PASSWORD=dev-only-change-me
