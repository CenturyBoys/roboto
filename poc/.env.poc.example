# Config do PoC (N3). Copie para poc/.env.poc (gitignored) e preencha.
# PROD renderiza do ansible-vault; aqui é só o PoC isolado.
# IMPORTANTE: NÃO use comentário na mesma linha de um valor — o parser do compose trata
# TUDO após o '=' como valor. Comentários só em linhas próprias, como estas.

# --- repos (1 empresa = N repos, D17) ---
TARGET_REPO_URL=https://github.com/arenavalendo/main.git
# PAT (pode ser o mesmo do GITHUB_API_TOKEN) p/ clonar https; vazio = ssh com chave montada
GITHUB_CLONE_TOKEN=
ROBOTO_DEFAULT_REPO=arenavalendo/main
# vários repos: a/x,a/y,a/z  (vazio = só o default)
ROBOTO_REPOS=arenavalendo/main
ROBOTO_TENANT=arenavalendo

# --- motor (Fase 0: stub | Fase 1: claude_code) ---
ROBOTO_ENGINE=claude_code
# chat do Telegram p/ perguntas do motor
ROBOTO_CHAT_ID=
# Smoke observável da Fase 1: se setar POC_TASK, roda SÓ o motor nessa tarefa e imprime
# cada evento (sem Postgres/Telegram/daemon). Vazio = daemon completo.
POC_TASK=

# --- modelos (OpenRouter) + STT (opcional) ---
OPENROUTER_API_KEY=sk-or-...
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1

# --- Telegram (bot da empresa) ---
TELEGRAM_BOT_TOKEN=000000:AAA...
TELEGRAM_ALLOWLIST=
CONSOLE_TOKEN=troque-isto

# --- GitHub: modo PAT (recomendado p/ PoC) ---
# 1 token fine-grained (Contents RW + Issues RW + Pull requests RW): serve p/ API e clone.
GITHUB_API_TOKEN=github_pat_...
# modo App (produção; deixe vazio no PoC PAT):
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- infra ---
DB_PASSWORD=dev-only-change-me
