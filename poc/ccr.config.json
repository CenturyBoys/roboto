{
  "LOG": false,
  "NON_INTERACTIVE_MODE": true,
  "Providers": [
    {
      "name": "openrouter",
      "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": ["qwen/qwen3-coder-next", "qwen/qwen3-coder-flash", "deepseek/deepseek-r1-0528", "anthropic/claude-sonnet-4.6"],
      "transformer": { "use": ["openrouter"] }
    }
  ],
  "Router": {
    "default": "openrouter,qwen/qwen3-coder-next",
    "background": "openrouter,qwen/qwen3-coder-flash",
    "think": "openrouter,qwen/qwen3-coder-next",
    "longContext": "openrouter,qwen/qwen3-coder-flash",
    "longContextThreshold": 60000
  }
}
