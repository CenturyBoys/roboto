{
  "LOG": false,
  "NON_INTERACTIVE_MODE": true,
  "Providers": [
    {
      "name": "openrouter",
      "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": ["google/gemini-3.1-flash-lite", "qwen/qwen3-coder-next", "qwen/qwen3-coder-flash", "deepseek/deepseek-r1-0528", "anthropic/claude-sonnet-4.6", "z-ai/glm-4.6"],
      "transformer": { "use": ["openrouter"] }
    }
  ],
  "Router": {
    "default": "openrouter,google/gemini-3.1-flash-lite",
    "background": "openrouter,google/gemini-3.1-flash-lite",
    "think": "openrouter,google/gemini-3.1-flash-lite",
    "longContext": "openrouter,google/gemini-3.1-flash-lite",
    "longContextThreshold": 60000
  }
}
